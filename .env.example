# StilYa worker secrets.
#
# Local development:   cp .env.example cloudflare-worker/.dev.vars   (then `npx wrangler dev`)
# Production:          npx wrangler secret put FAL_KEY               (repeat for each secret)
#
# Only FAL_KEY is required to generate images. Everything else is optional.
# App-side values (API URL, RevenueCat key, ...) live in Config/Secrets.xcconfig.

# ── Required ────────────────────────────────────────────────
# fal API key: https://fal.ai/dashboard/keys
FAL_KEY=

# ── Optional: credits, purchases, trends (Firestore via service account) ──
# Firebase service account JSON on a single line. Without it, credits are not
# metered and every authenticated user can generate.
GOOGLE_SERVICE_ACCOUNT_JSON=

# RevenueCat secret API key (server-side purchase verification)
REVENUECAT_API_KEY=

# ── Optional: device abuse prevention (Apple DeviceCheck) ──
APPLE_TEAM_ID=
DEVICECHECK_KEY_ID=
DEVICECHECK_PRIVATE_KEY=

# ── Optional: admin panel at /admin?key=... ──
ADMIN_SECRET=

# ── Optional: public origin for R2 asset links (defaults to the request origin) ──
PUBLIC_BASE_URL=
